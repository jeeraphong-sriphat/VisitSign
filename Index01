<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.6/dist/signature_pad.umd.min.js"></script>
  <style>
    :root {
      --primary: #0f766e;
      --primary-dark: #0b5a54;
      --bg: #f4f7f6;
      --card: #ffffff;
      --border: #dbe3e1;
      --text: #1f2937;
      --muted: #6b7280;
    }
    * { box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', 'Sarabun', sans-serif;
      background: var(--bg);
      color: var(--text);
      margin: 0;
      padding: 16px;
    }
    .container { max-width: 720px; margin: 0 auto; }

    /* ===== Document control header (matches FM-LAB-031) ===== */
    .form-header {
      background: #fff;
      border: 1.5px solid #111;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 16px;
      font-size: 12.5px;
    }
    .fh-top { display: flex; }
    .fh-logo {
      flex: 0 0 34%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8px;
      border-right: 1.5px solid #111;
    }
    .fh-logo img { max-width: 100%; height: auto; }
    .fh-code {
      flex: 0 0 33%;
      padding: 8px 10px;
      border-right: 1.5px solid #111;
      text-align: center;
    }
    .fh-code .code-main { font-weight: 700; font-size: 15px; margin: 2px 0; }
    .fh-dept { flex: 1; padding: 8px 10px; }
    .fh-dept b { display: block; margin-bottom: 2px; }
    .fh-title {
      border-top: 1.5px solid #111;
      padding: 8px 10px;
      font-weight: 700;
      font-size: 13.5px;
    }

    h1 { font-size: 18px; margin: 4px 0 16px; color: var(--primary-dark); }
    .tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
      background: var(--card);
      padding: 6px;
      border-radius: 10px;
      border: 1px solid var(--border);
    }
    .tab-btn {
      flex: 1;
      padding: 10px;
      border: none;
      background: transparent;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      color: var(--muted);
      font-weight: 600;
    }
    .tab-btn.active { background: var(--primary); color: white; }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
    }
    label { display: block; font-size: 14px; font-weight: 600; margin: 14px 0 6px; }
    input[type=text], input[type=date], select, textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
    }
    .sig-wrap {
      border: 1px dashed var(--border);
      border-radius: 8px;
      background: #fafafa;
      position: relative;
      touch-action: none;
    }
    canvas { width: 100%; height: 160px; display: block; border-radius: 8px; }
    .sig-actions { display: flex; justify-content: flex-end; margin-top: 6px; }
    .link-btn {
      background: none; border: none; color: var(--primary); font-size: 13px;
      cursor: pointer; text-decoration: underline; padding: 4px;
    }
    .btn {
      width: 100%;
      padding: 12px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 20px;
    }
    .btn.secondary {
      background: #fff; color: var(--primary); border: 1.5px solid var(--primary);
    }
    .btn:disabled { background: #a3a3a3; cursor: not-allowed; border-color: #a3a3a3; }
    .msg { padding: 10px 12px; border-radius: 8px; font-size: 14px; margin-top: 12px; display: none; }
    .msg.ok { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; display: block; }
    .msg.err { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; display: block; }
    .month-row { display: flex; gap: 8px; align-items: center; }
    table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 13px; }
    th, td { border: 1px solid var(--border); padding: 6px 8px; text-align: left; vertical-align: middle; }
    th { background: #f0f4f3; }
    td.sig-cell img { max-height: 32px; max-width: 90px; }
    .count-badge {
      display: inline-block; background: #e6f4f1; color: var(--primary-dark);
      padding: 4px 10px; border-radius: 999px; font-size: 13px; font-weight: 700;
      margin-top: 8px;
    }
    .signed-box {
      background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 10px;
      padding: 14px; margin-top: 16px;
    }
    .signed-box img { max-height: 60px; display: block; margin: 6px 0; }
    .spinner { text-align: center; color: var(--muted); font-size: 13px; padding: 12px 0; }

    /* ===== Printable report (hidden on screen, shown only on print) ===== */
    #printArea { display: none; }
    @media print {
      body * { visibility: hidden; }
      #printArea, #printArea * { visibility: visible; }
      #printArea { display: block; position: absolute; top: 0; left: 0; width: 100%; }
      .print-header { border: 1.5px solid #111; font-size: 12px; }
      .print-header .fh-top { display: flex; }
      .print-header .fh-logo { flex: 0 0 34%; border-right: 1.5px solid #111; padding: 6px; text-align: center; }
      .print-header .fh-logo img { max-width: 100%; }
      .print-header .fh-code { flex: 0 0 33%; border-right: 1.5px solid #111; padding: 6px 10px; text-align: center; }
      .print-header .fh-dept { flex: 1; padding: 6px 10px; }
      .print-header .fh-title { border-top: 1.5px solid #111; padding: 6px 10px; font-weight: 700; }
      #printArea table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 11px; }
      #printArea th, #printArea td { border: 1px solid #111; padding: 4px 6px; }
      #printArea td.sig-cell img { max-height: 26px; }
      .print-signoff { margin-top: 40px; text-align: right; padding-right: 40px; font-size: 12.5px; }
      .print-signoff img { display: block; margin-left: auto; max-height: 55px; margin-bottom: 2px; }
      .print-footer { margin-top: 30px; text-align: center; font-size: 10.5px; color: #333; }
    }
  </style>
</head>
<body>
<div class="container">

  <!-- ===== Document control header (FM-LAB-031) ===== -->
  <div class="form-header" id="screenHeader">
    <div class="fh-top">
      <div class="fh-logo"><img id="logoImg" src="" alt="logo"></div>
      <div class="fh-code">
        รหัสเอกสาร<br>
        <span class="code-main" id="hdrCode">FM-LAB-031</span><br>
        แก้ไขครั้งที่ <span id="hdrRev">00</span><br>
        วันที่อนุมัติใช้ <span id="hdrDate">01/04/2567</span>
      </div>
      <div class="fh-dept">
        <b>หน่วยงาน:</b> <span id="hdrDept"></span><br>
        <b>หมายเลขโทรศัพท์:</b> <span id="hdrPhone"></span>
      </div>
    </div>
    <div class="fh-title" id="hdrTitle"></div>
  </div>

  <div class="tabs">
    <button class="tab-btn active" id="tabEntryBtn" onclick="showTab('entry')">บันทึกข้อมูล</button>
    <button class="tab-btn" id="tabSummaryBtn" onclick="showTab('summary')">สรุปรายเดือน (หัวหน้า)</button>
  </div>

  <!-- ===== ENTRY TAB ===== -->
  <div id="entryTab" class="card">
    <label>วันที่</label>
    <input type="date" id="entryDate">

    <label>ชื่อ-สกุล</label>
    <input type="text" id="entryName" placeholder="ชื่อ-นามสกุลผู้เข้าปฏิบัติงาน/ติดต่อ">

    <label>กิจกรรม/หมายเหตุ</label>
    <select id="entryActivity" onchange="toggleOtherActivity()">
      <option value="">-- เลือกกิจกรรม --</option>
    </select>

    <div id="otherActivityWrap" style="display:none;">
      <label>ระบุกิจกรรม (อื่นๆ)</label>
      <input type="text" id="entryActivityOther" placeholder="โปรดระบุรายละเอียด">
    </div>

    <label>ลายเซ็น</label>
    <div class="sig-wrap"><canvas id="entrySigPad"></canvas></div>
    <div class="sig-actions"><button class="link-btn" onclick="clearSig(entrySignaturePad)">ล้างลายเซ็น</button></div>

    <button class="btn" id="entrySubmitBtn" onclick="submitEntry()">บันทึกข้อมูล</button>
    <div class="msg" id="entryMsg"></div>
  </div>

  <!-- ===== SUMMARY TAB ===== -->
  <div id="summaryTab" class="card" style="display:none;">
    <label>เลือกเดือน/ปี</label>
    <div class="month-row">
      <input type="month" id="summaryMonth">
      <button class="btn" style="margin-top:0;width:auto;padding:10px 16px;" onclick="loadSummary()">ดูข้อมูล</button>
    </div>

    <div id="summaryResult"></div>
  </div>
</div>

<!-- ===== PRINTABLE REPORT (matches FM-LAB-031 layout, screen-hidden) ===== -->
<div id="printArea">
  <div class="print-header form-header">
    <div class="fh-top">
      <div class="fh-logo"><img id="printLogoImg" src=""></div>
      <div class="fh-code">
        รหัสเอกสาร<br>
        <span class="code-main" id="pHdrCode"></span><br>
        แก้ไขครั้งที่ <span id="pHdrRev"></span><br>
        วันที่อนุมัติใช้ <span id="pHdrDate"></span>
      </div>
      <div class="fh-dept">
        <b>หน่วยงาน:</b> <span id="pHdrDept"></span><br>
        <b>หมายเลขโทรศัพท์:</b> <span id="pHdrPhone"></span>
      </div>
    </div>
    <div class="fh-title" id="pHdrTitle"></div>
  </div>

  <p style="margin:8px 0 0;"><b>สรุปรายเดือน:</b> <span id="pMonthLabel"></span> &nbsp; | &nbsp; <b>จำนวนรายการ:</b> <span id="pCount"></span> รายการ</p>

  <table>
    <tr><th>วันที่</th><th>ชื่อ - สกุล</th><th>ลายเซ็น</th><th>กิจกรรม/หมายเหตุ</th></tr>
    <tbody id="pTableBody"></tbody>
  </table>

  <div class="print-signoff">
    <div>ลงนาม</div>
    <img id="pSignOffImg" src="">
    <div>(<span id="pSignerTitle"></span>)</div>
    <div id="pSignedDate"></div>
  </div>

  <div class="print-footer" id="pFooterAddr"></div>
</div>

<script>
  let entrySignaturePad, signOffSignaturePad;
  let currentYearMonth = '';
  let formConfig = null;
  const LOGO_DATA_URI = 'data:image/jpeg;base64,';

  window.onload = function () {
    document.getElementById('logoImg').src = LOGO_DATA_URI;
    document.getElementById('printLogoImg').src = LOGO_DATA_URI;

    document.getElementById('entryDate').valueAsDate = new Date();
    const now = new Date();
    document.getElementById('summaryMonth').value =
      now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0');

    entrySignaturePad = initSignaturePad('entrySigPad');

    google.script.run.withSuccessHandler(populateActivities).getActivityOptions();
    google.script.run.withSuccessHandler(applyFormConfig).getFormConfig();
  };

  function applyFormConfig(cfg) {
    formConfig = cfg;
    document.getElementById('hdrCode').textContent = cfg.formCode;
    document.getElementById('hdrRev').textContent = cfg.revision;
    document.getElementById('hdrDate').textContent = cfg.approvedDate;
    document.getElementById('hdrDept').textContent = cfg.department;
    document.getElementById('hdrPhone').textContent = cfg.phone;
    document.getElementById('hdrTitle').textContent = 'ชื่อเอกสาร: ' + cfg.documentTitle;

    document.getElementById('pHdrCode').textContent = cfg.formCode;
    document.getElementById('pHdrRev').textContent = cfg.revision;
    document.getElementById('pHdrDate').textContent = cfg.approvedDate;
    document.getElementById('pHdrDept').textContent = cfg.department;
    document.getElementById('pHdrPhone').textContent = cfg.phone;
    document.getElementById('pHdrTitle').textContent = 'ชื่อเอกสาร: ' + cfg.documentTitle;
    document.getElementById('pFooterAddr').textContent = cfg.orgAddress + ' โทร ' + cfg.orgPhone;
  }

  function populateActivities(options) {
    const sel = document.getElementById('entryActivity');
    options.forEach(opt => {
      const el = document.createElement('option');
      el.value = opt; el.textContent = opt;
      sel.appendChild(el);
    });
  }

  function toggleOtherActivity() {
    const val = document.getElementById('entryActivity').value;
    document.getElementById('otherActivityWrap').style.display =
      val === 'อื่นๆ (โปรดระบุ)' ? 'block' : 'none';
  }

  function initSignaturePad(canvasId) {
    const canvas = document.getElementById(canvasId);
    resizeCanvas(canvas);
    window.addEventListener('resize', () => resizeCanvas(canvas));
    return new SignaturePad(canvas, { backgroundColor: 'rgba(255,255,255,1)' });
  }

  function resizeCanvas(canvas) {
    const ratio = Math.max(window.devicePixelRatio || 1, 1);
    canvas.width = canvas.offsetWidth * ratio;
    canvas.height = canvas.offsetHeight * ratio;
    canvas.getContext('2d').scale(ratio, ratio);
  }

  function clearSig(pad) { if (pad) pad.clear(); }

  function showTab(tab) {
    document.getElementById('entryTab').style.display = tab === 'entry' ? 'block' : 'none';
    document.getElementById('summaryTab').style.display = tab === 'summary' ? 'block' : 'none';
    document.getElementById('tabEntryBtn').classList.toggle('active', tab === 'entry');
    document.getElementById('tabSummaryBtn').classList.toggle('active', tab === 'summary');
  }

  function submitEntry() {
    const date = document.getElementById('entryDate').value;
    const name = document.getElementById('entryName').value.trim();
    const activity = document.getElementById('entryActivity').value;
    const activityOther = document.getElementById('entryActivityOther').value.trim();
    const msgBox = document.getElementById('entryMsg');
    msgBox.className = 'msg'; msgBox.style.display = 'none';

    if (!date || !name || !activity || entrySignaturePad.isEmpty()) {
      showMsg(msgBox, 'กรุณากรอกข้อมูลให้ครบถ้วน และลงลายเซ็นก่อนบันทึก', false);
      return;
    }

    const btn = document.getElementById('entrySubmitBtn');
    btn.disabled = true; btn.textContent = 'กำลังบันทึก...';

    google.script.run
      .withSuccessHandler(function () {
        showMsg(msgBox, '✅ บันทึกข้อมูลเรียบร้อยแล้ว', true);
        resetEntryForm();
        btn.disabled = false; btn.textContent = 'บันทึกข้อมูล';
      })
      .withFailureHandler(function (err) {
        showMsg(msgBox, '❌ เกิดข้อผิดพลาด: ' + err.message, false);
        btn.disabled = false; btn.textContent = 'บันทึกข้อมูล';
      })
      .submitVisitorEntry({
        date: date, name: name, activity: activity,
        activityOther: activityOther,
        signatureBase64: entrySignaturePad.toDataURL('image/png')
      });
  }

  function resetEntryForm() {
    document.getElementById('entryName').value = '';
    document.getElementById('entryActivity').value = '';
    document.getElementById('entryActivityOther').value = '';
    document.getElementById('otherActivityWrap').style.display = 'none';
    entrySignaturePad.clear();
    document.getElementById('entryDate').valueAsDate = new Date();
  }

  function showMsg(box, text, ok) {
    box.textContent = text;
    box.className = 'msg ' + (ok ? 'ok' : 'err');
    box.style.display = 'block';
  }

  function loadSummary() {
    const ym = document.getElementById('summaryMonth').value; // yyyy-MM
    if (!ym) return;
    currentYearMonth = ym;
    const resultDiv = document.getElementById('summaryResult');
    resultDiv.innerHTML = '<div class="spinner">กำลังโหลดข้อมูล...</div>';

    google.script.run
      .withSuccessHandler(function (data) {
        renderSummary(ym, data);
      })
      .withFailureHandler(function (err) {
        resultDiv.innerHTML = '<div class="msg err" style="display:block;">โหลดข้อมูลไม่สำเร็จ: ' + err.message + '</div>';
      })
      .getMonthlySummary(ym);
  }

  function renderSummary(ym, data) {
    const resultDiv = document.getElementById('summaryResult');
    let html = '<span class="count-badge">รายการทั้งหมด: ' + data.count + ' รายการ</span>';

    // ตารางแสดงผลบนหน้าจอ (ลำดับคอลัมน์ตรงกับฟอร์ม FM-LAB-031: วันที่/ชื่อ-สกุล/ลายเซ็น/กิจกรรม)
    if (data.entries.length > 0) {
      html += '<table><tr><th>วันที่</th><th>ชื่อ-สกุล</th><th>ลายเซ็น</th><th>กิจกรรม/หมายเหตุ</th></tr>';
      data.entries.forEach(e => {
        html += '<tr><td>' + e.date + '</td><td>' + escapeHtml(e.name) + '</td>' +
          '<td class="sig-cell">' + (e.sigUrl ? '<img src="' + e.sigUrl + '">' : '') + '</td>' +
          '<td>' + escapeHtml(e.activity) + '</td></tr>';
      });
      html += '</table>';
    } else {
      html += '<p style="color:#6b7280;font-size:14px;">ไม่มีรายการในเดือนนี้</p>';
    }

    if (data.signOff && data.signOff.signed) {
      html += '<div class="signed-box">' +
        '✅ <strong>ลงนามรับทราบแล้ว</strong><br>' +
        (data.signOff.sigUrl ? '<img src="' + data.signOff.sigUrl + '">' : '') +
        'โดย: ' + escapeHtml(data.signOff.signerName) +
        (data.signOff.signerTitle ? ' (' + escapeHtml(data.signOff.signerTitle) + ')' : '') + '<br>' +
        'วันที่ลงนาม: ' + data.signOff.signedDate +
        '</div>' +
        '<button class="btn secondary" onclick="printReport()">🖨️ พิมพ์รายงาน (FM-LAB-031)</button>' +
        '<button class="btn secondary" id="exportPdfBtn" onclick="exportPdf(\'' + ym + '\')">📄 Export เป็นไฟล์ PDF</button>' +
        '<div class="msg" id="exportMsg"></div>';
      resultDiv.innerHTML = html;
      preparePrintArea(ym, data);
      return;
    }

    const defaultTitle = formConfig ? formConfig.signerTitleDefault : '';
    html += '<label style="margin-top:20px;">ชื่อ-สกุลผู้ลงนามรับทราบ (หัวหน้า)</label>' +
      '<input type="text" id="signerName" placeholder="ชื่อ-นามสกุล">' +
      '<label>ตำแหน่ง</label>' +
      '<input type="text" id="signerTitle" value="' + escapeHtml(defaultTitle) + '">' +
      '<label>ลายเซ็นรับทราบ</label>' +
      '<div class="sig-wrap"><canvas id="signOffSigPad"></canvas></div>' +
      '<div class="sig-actions"><button class="link-btn" onclick="clearSig(signOffSignaturePad)">ล้างลายเซ็น</button></div>' +
      '<button class="btn" id="signOffBtn" onclick="submitSignOff(\'' + ym + '\')">ลงนามรับทราบ</button>' +
      '<div class="msg" id="signOffMsg"></div>';

    resultDiv.innerHTML = html;
    signOffSignaturePad = initSignaturePad('signOffSigPad');
  }

  function submitSignOff(ym) {
    const name = document.getElementById('signerName').value.trim();
    const title = document.getElementById('signerTitle').value.trim();
    const msgBox = document.getElementById('signOffMsg');

    if (!name || signOffSignaturePad.isEmpty()) {
      showMsg(msgBox, 'กรุณากรอกชื่อผู้ลงนาม และลงลายเซ็น', false);
      return;
    }

    const btn = document.getElementById('signOffBtn');
    btn.disabled = true; btn.textContent = 'กำลังบันทึก...';

    google.script.run
      .withSuccessHandler(function () {
        loadSummary(); // reload to show signed state
      })
      .withFailureHandler(function (err) {
        showMsg(msgBox, '❌ ' + err.message, false);
        btn.disabled = false; btn.textContent = 'ลงนามรับทราบ';
      })
      .submitMonthlySignOff({
        yearMonth: ym, signerName: name, signerTitle: title,
        signatureBase64: signOffSignaturePad.toDataURL('image/png')
      });
  }

  function preparePrintArea(ym, data) {
    document.getElementById('pMonthLabel').textContent = ym;
    document.getElementById('pCount').textContent = data.count;

    let rows = '';
    data.entries.forEach(e => {
      rows += '<tr><td>' + e.date + '</td><td>' + escapeHtml(e.name) + '</td>' +
        '<td class="sig-cell">' + (e.sigUrl ? '<img src="' + e.sigUrl + '">' : '') + '</td>' +
        '<td>' + escapeHtml(e.activity) + '</td></tr>';
    });
    document.getElementById('pTableBody').innerHTML = rows;

    document.getElementById('pSignOffImg').src = data.signOff.sigUrl || '';
    document.getElementById('pSignerTitle').textContent = data.signOff.signerTitle || '';
    document.getElementById('pSignedDate').textContent = 'วันที่ ' + (data.signOff.signedDate || '');
  }

  function printReport() { window.print(); }

  function exportPdf(ym) {
    const btn = document.getElementById('exportPdfBtn');
    const msgBox = document.getElementById('exportMsg');
    btn.disabled = true; btn.textContent = 'กำลังสร้างไฟล์...';

    google.script.run
      .withSuccessHandler(function (result) {
        btn.disabled = false; btn.textContent = '📄 Export เป็นไฟล์ PDF';
        downloadBase64File(result.base64, result.filename, 'application/pdf');
      })
      .withFailureHandler(function (err) {
        btn.disabled = false; btn.textContent = '📄 Export เป็นไฟล์ PDF';
        showMsg(msgBox, '❌ ' + err.message, false);
      })
      .exportMonthlyReportPDF(ym);
  }

  function downloadBase64File(base64Data, filename, mimeType) {
    const byteChars = atob(base64Data);
    const byteNumbers = new Array(byteChars.length);
    for (let i = 0; i < byteChars.length; i++) {
      byteNumbers[i] = byteChars.charCodeAt(i);
    }
    const byteArray = new Uint8Array(byteNumbers);
    const blob = new Blob([byteArray], { type: mimeType });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/[&<>"']/g, m => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[m]));
  }
